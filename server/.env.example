# Porta da API Express
PORT=4000

# Origem liberada para o cliente (Vite). Use vírgula para múltiplas.
CLIENT_ORIGIN=http://localhost:5173

# Segredo de assinatura dos tokens JWT — troque em produção
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Caminho do banco SQLite (relativo à pasta server/)
DATABASE_PATH=./data/grimorio.db

# Raiz dos JSONs do banco 5e (padrão: <repo>/5e-database-main/src/2014)
# SRD_DB_PATH=/caminho/para/5e-database-main/src/2014
